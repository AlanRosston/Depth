+    # [DEPTH patch] A failed send counts as too long if the marker is on stderr or stdout, or if the command is
+    # longer than _DEPTH_LONG_COMMAND_BYTES and the send produced no output.
+    _DEPTH_LONG_COMMAND_BYTES = 1024
+
+    def _is_command_too_long_error(self, result: ExecResult, command: str = "") -> bool:
+        if result.return_code == 0:
+            return False
+        out = (result.stderr or "") + (result.stdout or "")
+        if self._TMUX_COMMAND_TOO_LONG_MARKER in out:
+            return True
+        return not out.strip() and self._utf8_len(command) > self._DEPTH_LONG_COMMAND_BYTES
 
